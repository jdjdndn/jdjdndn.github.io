{
  "name": "github-io-coupon-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch-api": "node api-data/fetch-data.mjs",
    "fetch-api:all": "node api-data/fetch-data.mjs && node api-data/update-jingxuan.mjs",
    "update-jingxuan": "node api-data/update-jingxuan.mjs",
    "update-jingxuan:login": "node api-data/update-jingxuan.mjs --login",
    "build": "node scripts/sync-friend-links.cjs && node scripts/gen-vue-pages.cjs && node scripts/gen-fuye-guides.cjs && node scripts/gen-og-image.cjs && node scripts/gen-icons.cjs && vite build && node scripts/copy-shared.cjs&& node scripts/compress-images.cjs && node scripts/gen-landing-pages.cjs",
    "preview": "vite preview",
    "check-expired": "node scripts/check-expired.cjs",
    "seo": "node scripts/seo-audit.cjs",
    "seo:fix": "node scripts/seo-audit.cjs --fix",
    "sync:links": "node scripts/sync-friend-links.cjs",
    "cf:build": "npm run build",
    "cf:deploy": "npx wrangler pages deploy dist",
    "cf:preview": "npx wrangler pages dev dist"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "social-share.js": "^1.0.16",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^5.2.0"
  }
}
