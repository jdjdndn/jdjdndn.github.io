{
  "name": "github-io-coupon-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch-api": "node api-data/fetch-data.mjs",
    "fetch-api:all": "node api-data/fetch-data.mjs && node api-data/update-jingxuan.mjs",
    "update-jingxuan": "node api-data/update-jingxuan.mjs",
    "update-jingxuan:login": "node api-data/update-jingxuan.mjs --login",
    "build:sync": "node scripts/sync-friend-links.cjs",
    "build:gen-pages": "node scripts/gen-vue-pages.cjs",
    "build:gen-fuye": "node scripts/gen-fuye-guides.cjs",
    "build:gen-og": "node scripts/gen-og-image.cjs",
    "build:gen-icons": "node scripts/gen-icons.cjs",
    "build:vite": "vite build",
    "build:copy-shared": "node scripts/copy-shared.cjs",
    "build:compress": "node scripts/compress-images.cjs",
    "build:gen-landing": "node scripts/gen-landing-pages.cjs",
    "build:links-page": "node scripts/build-links-page.mjs json",
    "build:prerender": "node scripts/prerender-spa.cjs",
    "build": "npm run build:sync && npm run build:gen-pages && npm run build:gen-fuye && npm run build:gen-og && npm run build:gen-icons && npm run build:vite && npm run build:copy-shared && npm run build:compress && npm run build:gen-landing && npm run build:links-page && npm run build:prerender",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-expired": "node scripts/check-expired.cjs",
    "seo": "node scripts/seo-audit.cjs",
    "seo:fix": "node scripts/seo-audit.cjs --fix",
    "sync:links": "node scripts/sync-friend-links.cjs",
    "cf:build": "vite build",
    "cf:deploy": "npx wrangler deploy --assets ./dist",
    "cf:preview": "npx wrangler preview",
    "prebuild": "node vendor/seo-optimizer/rebuild-all.cjs --prebuild github.io"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "social-share.js": "^1.0.16",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^15.15.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "vite": "^5.2.0",
    "wrangler": "^4.130.0"
  }
}
